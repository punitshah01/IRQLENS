# IRQLENS backend configuration (not loaded automatically; export in the launching shell)
IRQLENS_HOST=127.0.0.1
IRQLENS_PORT=10000
IRQLENS_DB_PATH=./data/irqlens.db
# Defaults to ./captures in the repository root when unset.
# IRQLENS_OUTPUT_DIR=/path/to/captures
IRQLENS_COLLECTION_INTERVAL=1.0
IRQLENS_SUPPORTED_INTERVALS=0.1,0.25,0.5,1,2,5,10
IRQLENS_RETENTION_MINUTES=30
IRQLENS_STORAGE_INCLUDE_VIRTUAL=0
IRQLENS_COMMAND_TIMEOUT_SECONDS=8.0
IRQLENS_LOG_LEVEL=INFO
IRQLENS_CORS_ORIGINS=*

# Single shared token for dashboard, API, WebSocket, and agents (required with --remote)
IRQLENS_TOKEN=
# Optional per-surface overrides of IRQLENS_TOKEN
IRQLENS_API_TOKEN=
IRQLENS_AGENT_TOKEN=

# Remote SUT agent liveness
IRQLENS_AGENT_HEARTBEAT_INTERVAL=5
IRQLENS_AGENT_STALE_THRESHOLD=15
