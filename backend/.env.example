# IRQLENS backend configuration
IRQLENS_HOST=0.0.0.0
IRQLENS_PORT=8080
IRQLENS_DB_PATH=./data/irqlens.db
IRQLENS_OUTPUT_DIR=/root/irqlens
IRQLENS_COLLECTION_INTERVAL=1.0
IRQLENS_SUPPORTED_INTERVALS=0.1,0.25,0.5,1,2,5,10
IRQLENS_METRIC_RETENTION=5000
IRQLENS_RETENTION_DAYS=14
IRQLENS_MAX_SESSIONS=100
IRQLENS_MAX_STORAGE_MB=1024
IRQLENS_COMMAND_TIMEOUT_SECONDS=8.0
IRQLENS_LOG_LEVEL=INFO
IRQLENS_CORS_ORIGINS=*

# Optional allowlist for ingest client IPs (comma-separated)
# Example: IRQLENS_ALLOWED_INGEST_IPS=10.140.153.54,10.140.130.136
IRQLENS_ALLOWED_INGEST_IPS=
IRQLENS_DISABLE_INGEST_ALLOWLIST=0
